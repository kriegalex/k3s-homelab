# Copy to .env on homelab1 (never commit .env). Reference:
# https://healthchecks.io/docs/self_hosted_configuration/
DEBUG=False
SECRET_KEY=CHANGE_ME                      # openssl rand -hex 32
SITE_NAME=homelab deadman
SITE_ROOT=http://10.0.0.50:8000
PING_ENDPOINT=http://10.0.0.50:8000/ping/
REGISTRATION_OPEN=False
DB=sqlite
DB_NAME=/data/hc.sqlite
# Notifications go to ntfy.sh (public internet), so private IPs stay blocked.
INTEGRATIONS_ALLOW_PRIVATE_IPS=False
PING_BODY_LIMIT=10000
# Optional second channel. Leave EMAIL_HOST empty to run without e-mail.
DEFAULT_FROM_EMAIL=healthchecks@example.org
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_VERIFICATION=False
