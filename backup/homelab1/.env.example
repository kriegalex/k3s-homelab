# Copy to .env in /opt/stacks/backup on homelab1, chmod 600, never commit it.

# busybox crond syntax, local time (TZ in docker-compose.yml). 01:30 finishes well
# before the 03:30 cluster job that reads the QNAP's S3 buckets.
SCHEDULE=30 1 * * *
# Days a deleted or overwritten file stays recoverable in hl1:_archive/
KEEP_DAYS=30

# Gitea database (POSTGRES_PASSWORD from /opt/stacks/gitea/docker-compose.yml)
PGHOST=gitea-postgresql
PGUSER=gitea
PGDATABASE=gitea
PGPASSWORD=CHANGE_ME

# Ping URL of the Healthchecks check `homelab1-backup`; empty = no pings
HC_URL=

# rclone remotes, defined as environment variables (no rclone.conf file).
# qnap: a QNAP S3 user that can only reach bucket homelab1-backup
RCLONE_CONFIG_QNAP_TYPE=s3
RCLONE_CONFIG_QNAP_PROVIDER=Other
RCLONE_CONFIG_QNAP_ENDPOINT=http://10.0.0.7:8010
RCLONE_CONFIG_QNAP_ACCESS_KEY_ID=CHANGE_ME
RCLONE_CONFIG_QNAP_SECRET_ACCESS_KEY=CHANGE_ME
# The bucket already exists and the key is scoped to it. Without this rclone
# calls CreateBucket before uploading, which the QNAP answers with a 409
# InvalidBucketState that fails every run after the first.
RCLONE_CONFIG_QNAP_NO_CHECK_BUCKET=true
# hl1: encryption layer on top of it. Both values are `rclone obscure` output;
# keep the two CLEAR passwords in the password manager — without them the
# backup cannot be read.
RCLONE_CONFIG_HL1_TYPE=crypt
RCLONE_CONFIG_HL1_REMOTE=qnap:homelab1-backup
RCLONE_CONFIG_HL1_PASSWORD=CHANGE_ME
RCLONE_CONFIG_HL1_PASSWORD2=CHANGE_ME
